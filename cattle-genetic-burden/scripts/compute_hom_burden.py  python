#!/usr/bin/env python
"""
Compute per-sample homozygous burden counts from BovCADD-annotated VCF.

Deleterious homozygous burden: GT is HOM_ALT and BovCADD > 20
Benign/tolerated homozygous burden: GT is HOM_ALT and BovCADD < 5
"""

import argparse
import cyvcf2
import pandas as pd
import numpy as np


def parse_args():
    p = argparse.ArgumentParser()
    p.add_argument("--vcf", required=True, help="BovCADD-annotated VCF(s)")
    p.add_argument("--out", required=True, help="Output CSV")
    p.add_argument("--del-threshold", type=float, default=20.0)
    p.add_argument("--benign-threshold", type=float, default=5.0)
    return p.parse_args()


def main():
    args = parse_args()
    vcf = cyvcf2.VCF(args.vcf)
    samples = vcf.samples
    n = len(samples)

    hom_del = np.zeros(n, dtype=int)
    hom_benign = np.zeros(n, dtype=int)
    het_del = np.zeros(n, dtype=int)   # optional, useful for masked load
    n_sites_del = 0
    n_sites_benign = 0

    for variant in vcf:
        score = variant.INFO.get("BovCADD")
        if score is None:
            continue
        score = float(score)

        gt_types = variant.gt_types  # 0=HOM_REF, 1=HET, 2=HOM_ALT, 3=UNKNOWN

        if score > args.del_threshold:
            n_sites_del += 1
            hom_del += (gt_types == 2).astype(int)
            het_del += (gt_types == 1).astype(int)
        elif score < args.benign_threshold:
            n_sites_benign += 1
            hom_benign += (gt_types == 2).astype(int)

    df = pd.DataFrame({
        "sample_id": samples,
        "hom_deleterious": hom_del,
        "het_deleterious": het_del,
        "hom_benign": hom_benign,
    })

    # Ratio burden metric — normalizes for individual inbreeding level
    df["burden_ratio"] = df["hom_deleterious"] / df["hom_benign"].replace(0, np.nan)

    df.to_csv(args.out, index=False)

    print(f"Sites with BovCADD > {args.del_threshold}: {n_sites_del}")
    print(f"Sites with BovCADD < {args.benign_threshold}: {n_sites_benign}")
    print(f"Wrote per-sample burden table to {args.out}")


if __name__ == "__main__":
    main()
